+/* Step 12 private single-session PC replay. All inputs are prior/current epoch. */
+enum { S12_A1 = 1, S12_A2, S12_A3, S12_A4 };
+static int s12_scheme, s12_epoch;
+static int s12_read_scheme(void)
+{
+    const char *p=getenv("STEP12_SCHEME");
+    const char *names[]={"A1_outlier_gim_mad","A2_stoch_ema_r",
+                         "A3_kf_amb_anneal","A4_pure_kf_anneal"};
+    for (int i=0;p && i<4;i++) if (!strcmp(p,names[i])) return i+1;
+    return 0;
+}
+
+typedef struct {
+    int signal, last_epoch, had_phase, lock, anchor_n, ema_count;
+    gtime_t seen, ema_time;
+    double anchor, drift, ema_var;
+} s12_track_t;
+static s12_track_t s12_track[MAXSAT][NFREQ];
+
+typedef struct {
+    int idx, sat, f, grp, cmc_valid;
+    double vg, base, cmc;
+} s12_code_t;
+static s12_code_t s12_codes[MAXOBS*NFREQ];
+static int s12_ncode, s12_slotmask[MAXSAT], s12_learned;
+static double s12_ion_increment[MAXSAT];
+static int s12_anneal_arcs;
+static double s12_anneal_var;
+typedef struct {
+    int code_rows, outliers, stochastic, ion_limited, fallback, no_group, cmc_boost;
+    double max_out, max_stoch, sum_stoch;
+} s12_counts_t;
+static s12_counts_t s12_trial;
+
+static void s12_begin_epoch(const rtk_t *rtk,const obsd_t *obs,int n)
+{
+    s12_epoch++;
+    s12_learned=s12_anneal_arcs=0;
+    s12_anneal_var=0.0;
+    memset(s12_ion_increment,0,sizeof(s12_ion_increment));
+    for (int i=0;i<n;i++) for (int f=0;f<rtk->opt.nf;f++) {
+        const int s=obs[i].sat-1;
+        const ssat_t *ss=rtk->ssat+s;
+        s12_track_t *t=&s12_track[s][f];
+        double dt=t->seen.time?timediff(obs[i].time,t->seen):0;
+        int phase=obs[i].L[f]!=0.0 && !(obs[i].LLI[f]&LLI_HALFC);
+        int loss=t->had_phase && (!phase || t->last_epoch+1!=s12_epoch);
+        if (loss || dt<=0.0 || dt>10.0 || t->signal!=obs[i].code[f] ||
+            ss->ppp_arc_reset[f] || ((ss->slip[f]|obs[i].LLI[f])&LLI_SLIP))
+            memset(t,0,sizeof(*t));
+        t->signal=obs[i].code[f];
+        t->last_epoch=s12_epoch;
+        t->seen=obs[i].time;
+        t->had_phase=phase;
+    }
+}
+
+/* Keep the physical code variance (including signal/code-only scaling)
+ * separate from products, smoother variance and legacy robust penalties. */
+static void s12_add_code(int idx,int sat,int f,int grp,double res,double base,
+    double scale,double ion_state,int gim_ok,double gim,double p,double l)
+{
+    s12_code_t *r=s12_codes+s12_ncode++;
+    r->idx=idx; r->sat=sat; r->f=f; r->grp=grp; r->base=base;
+    r->vg=res+(gim_ok?scale*(ion_state-gim):0.0);
+    r->cmc_valid=gim_ok && p!=0.0 && l!=0.0;
+    r->cmc=r->cmc_valid?p-l-2.0*scale*gim:0.0;
+}
+
+static int s12_group(const s12_code_t *r,int any_slot,double *med,double *mad)
+{
+    double vals[MAXOBS*NFREQ];
+    int n=0,nsat=0;
+    unsigned char seen[MAXSAT]={0};
+    for (int j=0;j<s12_ncode;j++) {
+        const s12_code_t *p=s12_codes+j;
+        if (p->grp!=r->grp || (!any_slot && p->f!=r->f)) continue;
+        vals[n++]=p->vg;
+        if (!seen[p->sat-1]++) nsat++;
+    }
+    if ((any_slot?n:nsat)<4) return 0;
+    *med=ppp_median(vals,n);
+    for (int j=0;j<n;j++) vals[j]=fabs(vals[j]-*med);
+    double spread=1.4826*ppp_median(vals,n);
+    *mad=MAX(1.5,spread);
+    return 1;
+}
+
+/* Advance empirical history once on the complete pre-edit rows. Subsequent
+ * trials may change A1 groups but reuse this epoch's EMA and arc anchor. */
+static void s12_learn(const s12_code_t *r,s12_track_t *t,gtime_t time,
+                      int grouped,double dv)
+{
+    if (r->cmc_valid && t->lock>=2) {
+        if (t->anchor_n<3) t->anchor+=(r->cmc-t->anchor)/++t->anchor_n;
+        t->drift=r->cmc-t->anchor;
+    } else {
+        t->anchor_n=0; t->anchor=t->drift=0.0;
+    }
+    if (!grouped) return;
+    double dt=t->ema_time.time?timediff(time,t->ema_time):0.0;
+    if (!t->ema_count || dt<=0.0 || dt>10.0) {
+        t->ema_count=1; t->ema_var=SQR(dv);
+    } else {
+        t->ema_count++; t->ema_var=0.92*t->ema_var+0.08*MIN(SQR(dv),400.0);
+    }
+    t->ema_time=time;
+}
+
+static void s12_weight(const rtk_t *rtk,gtime_t time,int nv,double *R,double *Pp)
+{
+    int stochastic=s12_scheme==S12_A2 || s12_scheme==S12_A3;
+    unsigned char out_sat[MAXSAT]={0};
+    memset(&s12_trial,0,sizeof(s12_trial));
+    s12_trial.max_out=s12_trial.max_stoch=1.0;
+    for (int i=0;i<s12_ncode;i++) {
+        s12_code_t *r=&s12_codes[i];
+        s12_track_t *t=&s12_track[r->sat-1][r->f];
+        double med=0.0,mad=1.5,fs=1.0,fo=1.0;
+        int grouped=s12_scheme!=S12_A4 && s12_group(r,0,&med,&mad);
+        if (s12_scheme!=S12_A4 && !grouped) {
+            grouped=s12_group(r,1,&med,&mad);
+            if (grouped) s12_trial.fallback++;
+            else s12_trial.no_group++;
+        }
+        double dv=r->vg-med;
+        if (stochastic && !s12_learned) s12_learn(r,t,time,grouped,dv);
+        if (stochastic && grouped && t->ema_count>=3 &&
+            timediff(time,t->ema_time)==0.0) {
+            fs=MIN(20.0,MAX(1.0,t->ema_var/MAX(r->base,2.25)));
+            if (r->cmc_valid && t->lock>=5 && fabs(t->drift)>2.0) {
+                fs*=1.0+0.5*SQR((fabs(t->drift)-2.0)/2.0);
+                fs=MIN(25.0,fs);
+                s12_trial.cmc_boost++;
+            }
+        }
+        if (grouped && (s12_scheme==S12_A1 || s12_scheme==S12_A3)) {
+            double u=fabs(dv)/mad;
+            if (u>2.5) {
+                fo=MIN(36.0,SQR(u/2.5)*(u>4.5?2.0:1.0));
+                out_sat[r->sat-1]=1;
+                s12_trial.outliers++;
+            }
+        }
+        /* Diagonal is var[row] as emitted by ppp_res. Add only the
+         * stochastic code increment, then A1 scales the complete row. */
+        int idx=r->idx*(nv+1);
+        R[idx]=(R[idx]+(fs-1.0)*r->base)*fo;
+        s12_trial.code_rows++; s12_trial.sum_stoch+=fs;
+        s12_trial.stochastic+=fs>1.0;
+        s12_trial.max_stoch=MAX(s12_trial.max_stoch,fs);
+        s12_trial.max_out=MAX(s12_trial.max_out,fo);
+    }
+    s12_learned=1;
+    if (s12_scheme==S12_A3) for (int s=0;s<MAXSAT;s++) {
+        int mask=s12_slotmask[s];
+        if (!out_sat[s] || !mask || (mask&(mask-1)) || s12_ion_increment[s]<=0) continue;
+        int j=II(s+1,&rtk->opt);
+        Pp[j*(rtk->nx+1)]-=0.5*s12_ion_increment[s];
+        s12_trial.ion_limited++;
+    }
+}
+
+static void s12_report(gtime_t time,int q,int iteration)
+{
+    int week;
+    double tow=time2gpst(time,&week);
+    const s12_counts_t *a=&s12_trial;
+    trace(2,"$S12_ACTION,%d,%.9f,%d,%d,%d,%d,%.17g,%d,%.17g,%.17g,%d,%.17g,%d,%d,%d,%d\n",
+        week,tow,q,iteration,a->code_rows,a->outliers,a->max_out,a->stochastic,
+        a->code_rows?a->sum_stoch/a->code_rows:1.0,a->max_stoch,
+        s12_anneal_arcs,s12_anneal_var,a->ion_limited,a->fallback,a->no_group,a->cmc_boost);
+}
