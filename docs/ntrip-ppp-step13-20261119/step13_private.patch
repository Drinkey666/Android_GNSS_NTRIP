+/* Step 13 private single-session PC replay. All inputs are prior/current epoch. */
+enum { EMA_ONLY=1, A1_IONQ, A1_EMA, A1_EMA_IONQ };
+static int s13_scheme, s13_epoch;
+static int s13_read_scheme(void)
+{
+    const char *p=getenv("STEP13_SCHEME");
+    const char *names[]={"B1_ema_only","B2_a1_ionq","B3_a1_ema","B4_a1_ema_ionq"};
+    for (int i=0;p && i<4;i++) if (!strcmp(p,names[i])) return i+1;
+    return 0;
+}
+
+typedef struct {
+    int signal, last_epoch, had_phase, ema_count;
+    gtime_t seen, ema_time;
+    double ema_var;
+} s13_track_t;
+static s13_track_t s13_track[MAXSAT][NFREQ];
+
+typedef struct {
+    int idx, sat, f, grp;
+    double vg, base;
+} s13_code_t;
+static s13_code_t s13_codes[MAXOBS*NFREQ];
+static int s13_ncode, s13_slotmask[MAXSAT], s13_learned;
+static double s13_ion_increment[MAXSAT];
+typedef struct {
+    int code_rows, outliers, stochastic, ion_limited, fallback, no_group, overlap;
+    double max_out, max_stoch, sum_stoch, ion_q_removed;
+} s13_counts_t;
+static s13_counts_t s13_trial;
+
+static void s13_begin_epoch(const rtk_t *rtk,const obsd_t *obs,int n)
+{
+    s13_epoch++;
+    s13_learned=0;
+    memset(s13_ion_increment,0,sizeof(s13_ion_increment));
+    for (int i=0;i<n;i++) for (int f=0;f<rtk->opt.nf;f++) {
+        const int s=obs[i].sat-1;
+        const ssat_t *ss=rtk->ssat+s;
+        s13_track_t *t=&s13_track[s][f];
+        double dt=t->seen.time?timediff(obs[i].time,t->seen):0;
+        int phase=obs[i].L[f]!=0.0 && !(obs[i].LLI[f]&LLI_HALFC);
+        int loss=t->had_phase && (!phase || t->last_epoch+1!=s13_epoch);
+        if (loss || dt<=0.0 || dt>10.0 || t->signal!=obs[i].code[f] ||
+            ss->ppp_arc_reset[f] || ((ss->slip[f]|obs[i].LLI[f])&LLI_SLIP))
+            memset(t,0,sizeof(*t));
+        t->signal=obs[i].code[f];
+        t->last_epoch=s13_epoch;
+        t->seen=obs[i].time;
+        t->had_phase=phase;
+    }
+}
+
+/* Keep the physical code variance (including signal/code-only scaling)
+ * separate from products, smoother variance and legacy robust penalties. */
+static void s13_add_code(int idx,int sat,int f,int grp,double res,double base,
+    double scale,double ion_state,int gim_ok,double gim)
+{
+    s13_code_t *r=s13_codes+s13_ncode++;
+    r->idx=idx; r->sat=sat; r->f=f; r->grp=grp; r->base=base;
+    r->vg=res+(gim_ok?scale*(ion_state-gim):0.0);
+}
+
+static int s13_group(const s13_code_t *r,int any_slot,double *med,double *mad)
+{
+    double vals[MAXOBS*NFREQ];
+    int n=0,nsat=0;
+    unsigned char seen[MAXSAT]={0};
+    for (int j=0;j<s13_ncode;j++) {
+        const s13_code_t *p=s13_codes+j;
+        if (p->grp!=r->grp || (!any_slot && p->f!=r->f)) continue;
+        vals[n++]=p->vg;
+        if (!seen[p->sat-1]++) nsat++;
+    }
+    if ((any_slot?n:nsat)<4) return 0;
+    *med=ppp_median(vals,n);
+    for (int j=0;j<n;j++) vals[j]=fabs(vals[j]-*med);
+    double spread=1.4826*ppp_median(vals,n);
+    *mad=MAX(1.5,spread);
+    return 1;
+}
+
+/* Advance empirical history once on the complete pre-edit rows. Subsequent
+ * trials may change A1 groups but reuse this epoch's EMA. */
+static void s13_learn(s13_track_t *t,gtime_t time,
+                      int grouped,double dv)
+{
+    if (!grouped) return;
+    double dt=t->ema_time.time?timediff(time,t->ema_time):0.0;
+    if (!t->ema_count || dt<=0.0 || dt>10.0) {
+        t->ema_count=1; t->ema_var=SQR(dv);
+    } else {
+        t->ema_count++; t->ema_var=0.92*t->ema_var+0.08*MIN(SQR(dv),400.0);
+    }
+    t->ema_time=time;
+}
+
+static void s13_weight(const rtk_t *rtk,gtime_t time,int nv,double *R,double *Pp)
+{
+    int stochastic=s13_scheme!=A1_IONQ;
+    unsigned char out_sat[MAXSAT]={0};
+    memset(&s13_trial,0,sizeof(s13_trial));
+    s13_trial.max_out=s13_trial.max_stoch=1.0;
+    for (int i=0;i<s13_ncode;i++) {
+        s13_code_t *r=&s13_codes[i];
+        s13_track_t *t=&s13_track[r->sat-1][r->f];
+        double med=0.0,mad=1.5,fs=1.0,fo=1.0;
+        int grouped=s13_group(r,0,&med,&mad);
+        if (!grouped) {
+            grouped=s13_group(r,1,&med,&mad);
+            if (grouped) s13_trial.fallback++;
+            else s13_trial.no_group++;
+        }
+        double dv=r->vg-med;
+        if (stochastic && !s13_learned) s13_learn(t,time,grouped,dv);
+        if (stochastic && grouped && t->ema_count>=3 &&
+            timediff(time,t->ema_time)==0.0) {
+            fs=MIN(20.0,MAX(1.0,t->ema_var/MAX(r->base,2.25)));
+        }
+        if (grouped && s13_scheme!=EMA_ONLY) {
+            double u=fabs(dv)/mad;
+            if (u>2.5) {
+                fo=MIN(36.0,SQR(u/2.5)*(u>4.5?2.0:1.0));
+                out_sat[r->sat-1]=1;
+                s13_trial.outliers++;
+            }
+        }
+        /* Diagonal is var[row] as emitted by ppp_res. Add only the
+         * stochastic code increment, then A1 scales the complete row. */
+        int idx=r->idx*(nv+1);
+        R[idx]=(R[idx]+(fs-1.0)*r->base)*fo;
+        s13_trial.code_rows++; s13_trial.sum_stoch+=fs;
+        s13_trial.stochastic+=fs>1.0;
+        s13_trial.overlap+=(fs>1.0 && fo>1.0);
+        s13_trial.max_stoch=MAX(s13_trial.max_stoch,fs);
+        s13_trial.max_out=MAX(s13_trial.max_out,fo);
+    }
+    s13_learned=1;
+    if (s13_scheme==A1_IONQ || s13_scheme==A1_EMA_IONQ) for (int s=0;s<MAXSAT;s++) {
+        int mask=s13_slotmask[s];
+        if (!out_sat[s] || !mask || (mask&(mask-1)) || s13_ion_increment[s]<=0) continue;
+        int j=II(s+1,&rtk->opt);
+        Pp[j*(rtk->nx+1)]-=0.5*s13_ion_increment[s];
+        s13_trial.ion_limited++;
+        s13_trial.ion_q_removed+=0.5*s13_ion_increment[s];
+    }
+}
+
+static void s13_report(gtime_t time,int q,int iteration)
+{
+    int week;
+    double tow=time2gpst(time,&week);
+    const s13_counts_t *a=&s13_trial;
+    trace(2,"$S13_ACTION,%d,%.9f,%d,%d,%d,%d,%.17g,%d,%.17g,%.17g,%d,%.17g,%d,%d,%d\n",
+        week,tow,q,iteration,a->code_rows,a->outliers,a->max_out,a->stochastic,
+        a->code_rows?a->sum_stoch/a->code_rows:1.0,a->max_stoch,
+        a->ion_limited,a->ion_q_removed,a->fallback,a->no_group,a->overlap);
+}
